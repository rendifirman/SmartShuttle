APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

### Paylabs configuration (Staging and Production)
# NOTE: By default both environments are inactive. Set *_ACTIVE to true to activate.
# Do NOT commit real keys into version control; use your environment management for secrets.

# Active environment name (staging|production). Leave empty to keep all inactive.
PAYLABS_ACTIVE_ENV=

# Generic (fallback) values - used only when explicit active env not selected
PAYLABS_MID=
PAYLABS_PRIVATE_KEY=
PAYLABS_PUBLIC_KEY=
PAYLABS_BASE_URL=
PAYLABS_ENDPOINT=/pembayaran
PAYLABS_CALLBACK_URL=

# Staging environment variables (defaults point to sandbox)
PAYLABS_STAGING_ACTIVE=false
PAYLABS_STAGING_ENVIRONMENT_NAME=staging
PAYLABS_STAGING_BASE_URL=https://sandbox.paylabs.co.id
PAYLABS_STAGING_ENDPOINT=/pembayaran
PAYLABS_STAGING_MID=
PAYLABS_STAGING_PRIVATE_KEY=
PAYLABS_STAGING_PRIVATE_KEY_FILE=
PAYLABS_STAGING_PUBLIC_KEY=
PAYLABS_STAGING_PUBLIC_KEY_FILE=
PAYLABS_STAGING_CALLBACK_URL=

# Production environment variables
PAYLABS_PRODUCTION_ACTIVE=false
PAYLABS_PRODUCTION_ENVIRONMENT_NAME=production
PAYLABS_PRODUCTION_BASE_URL=https://pay.paylabs.co.id
PAYLABS_PRODUCTION_ENDPOINT=/pembayaran
PAYLABS_PRODUCTION_MID=
PAYLABS_PRODUCTION_PRIVATE_KEY=
PAYLABS_PRODUCTION_PRIVATE_KEY_FILE=
PAYLABS_PRODUCTION_PUBLIC_KEY=
PAYLABS_PRODUCTION_PUBLIC_KEY_FILE=
PAYLABS_PRODUCTION_CALLBACK_URL=
